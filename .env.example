# Ichika Bot Configuration

# Bot Name
BOT_NAME=Ichika

# Admin IDs (comma-separated WhatsApp JIDs)
ADMIN_IDS=

# AI Settings
AI_MODEL=gpt-3.5-turbo
AI_API_KEY=your_api_key_here
AI_DEFAULT_MODE=normal

# Database
DATABASE_PATH=./database/

# Moderation
ENABLE_MODERATION=true
ENABLE_AUTO_REPLY=true

# Features
ENABLE_AI=true
ENABLE_GAMES=true
ENABLE_RPG=true
ENABLE_ANIME=true
ENABLE_NEWS=true

# Message Context Buffer
CONTEXT_BUFFER_SIZE=100

# Cooldowns (in ms)
DAILY_COOLDOWN=86400000
COMMAND_COOLDOWN=1000

# Development
DEBUG=false
